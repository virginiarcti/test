# 3. Parameters
parameters <- c(
beta = 0.01
)
# 4. Time sequence
times <- seq(0, 100, by = 1)
# 5. Solve model
results <- ode(
y = state,
times = times,
func = SI_model,
parms = parameters
)
# 6. Convert to data frame
results <- as.data.frame(results)
# 7. View results
head(results)
