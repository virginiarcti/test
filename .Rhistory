# 1. Define SI model
SI_model <- function(time, state, parameters) {
with(as.list(c(state, parameters)), {
dS <- -beta * S * I
dI <-  beta * S * I
list(c(dS, dI))
})
}
# 2. Initial values
state <- c(
S = 90,
I = 10
)
# 3. Parameters
parameters <- c(
beta = 0.0001
)
# 4. Time sequence
times <- seq(0, 100, by = 1)
# 5. Solve model
