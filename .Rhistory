# INITIAL CONDITIONS
S <- 90
I <- 10
# NUMBER OF TIME STEPS
n <- 5
# CREATE STORAGE TABLE
results <- data.frame(
time = 0:n,
S = NA,
I = NA,
dS = NA,
dI = NA
)
# STORE INITIAL VALUES
results$S[1] <- S
results$I[1] <- I
results$dS[1] <- 0
results$dI[1] <- 0
# ITERATE THROUGH TIME
for (t in 1:n) {
# compute change
dS <- -beta * S * I
dI <-  beta * S * I
# update values
S <- S + dS
I <- I + dI
# store results
results$S[t + 1] <- S
results$I[t + 1] <- I
results$dS[t + 1] <- dS
results$dI[t + 1] <- dI
}
# PRINT FINAL TABLE
print(results)
