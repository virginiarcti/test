# Load required packages
library(corrplot)
library(car)
# Import data
malaria <- read.csv("C:/Users/VIRGINIAH/Desktop/malariaall.csv",
header = TRUE,
stringsAsFactors = FALSE)
# Rename variables
names(malaria) <- c("ParasiteIncidence",
"ParasiteRate",
"Mortality",
"ITNUse",
"ITNAccess")
# Display dataset information
cat("Dimensions of dataset:\n")
print(dim(malaria))
cat("\nVariable names:\n")
print(names(malaria))
cat("\nSummary statistics:\n")
print(summary(malaria))
# Check for missing values
cat("\nMissing values:\n")
print(colSums(is.na(malaria)))
par(mfrow = c(2,2))
hist(malaria$ParasiteIncidence,
main="Parasite Incidence",
xlab="Incidence",
col="lightblue")
hist(malaria$Mortality,
main="Mortality",
xlab="Mortality Rate",
col="lightgreen")
hist(malaria$ITNUse,
main="ITN Use",
xlab="ITN Use",
col="orange")
hist(malaria$ITNAccess,
main="ITN Access",
xlab="ITN Access",
col="pink")
correlation <- cor(malaria, use="complete.obs")
cat("\nCorrelation Matrix:\n")
print(round(correlation,3))
corrplot(correlation,
method="color",
addCoef.col="black",
number.cex=0.7)
par(mfrow=c(1,2))
plot(malaria$ITNUse,
malaria$ParasiteIncidence,
pch=16,
xlab="ITN Use",
ylab="Parasite Incidence",
main="ITN Use vs Parasite Incidence")
abline(lm(ParasiteIncidence~ITNUse,data=malaria),
col="red",
lwd=2)
plot(malaria$ITNAccess,
malaria$ParasiteIncidence,
pch=16,
xlab="ITN Access",
ylab="Parasite Incidence",
main="ITN Access vs Parasite Incidence")
abline(lm(ParasiteIncidence~ITNAccess,data=malaria),
col="blue",
lwd=2)
model <- lm(ParasiteIncidence ~
Mortality +
ITNUse +
ITNAccess,
data=malaria)
cat("\nRegression Results:\n")
print(summary(model))
cat("\nVariance Inflation Factors (VIF):\n")
print(vif(model))
par(mfrow=c(2,2))
plot(model)
print(summary(pca))
biplot(pca)
save(model,
file="C:/Users/VIRGINIAH/Desktop/Malaria_Model.RData")
cat("\nAnalysis completed successfully!\n")
