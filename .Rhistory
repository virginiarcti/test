#####
# SI MODEL PARAMETERS
beta <- 0.01
# INITIAL CONDITIONS
S <- 90
I <- 10
# NUMBER OF TIME STEPS
n <- 5
# CREATE STORAGE TABLE
results <- data.frame(
time = 0:n,
S = NA,
I = NA,
dS = NA,
dI = NA
)
# STORE INITIAL VALUES
results$S[1] <- S
results$I[1] <- I
results$dS[1] <- 0
results$dI[1] <- 0
# ITERATE THROUGH TIME
for (t in 1:n) {
# compute change
dS <- -beta * S * I
dI <-  beta * S * I
# update values
S <- S + dS
I <- I + dI
# store results
results$S[t + 1] <- S
results$I[t + 1] <- I
results$dS[t + 1] <- dS
results$dI[t + 1] <- dI
}
# PRINT FINAL TABLE
print(results)
# 1. Define SI model
SI_model <- function(time, state, parameters) {
with(as.list(c(state, parameters)), {
dS <- -beta * S * I
dI <-  beta * S * I
list(c(dS, dI))
})
}
# 2. Initial values
state <- c(
S = 900,
I = 100
)
# 3. Parameters
parameters <- c(
beta = 0.01
)
# 4. Time sequence
times <- seq(0, 100, by = 1)
# 5. Solve model
results <- ode(
y = state,
times = times,
func = SI_model,
parms = parameters
)
# 6. Convert to data frame
results <- as.data.frame(results)
# 7. View results
head(results)
# 8. Plot results
plot(results$time, results$S, type = "l", lwd = 2,
xlab = "Time", ylab = "Population", ylim = c(0, 100))
lines(results$time, results$I, lwd = 2, lty = 2)
legend("right",
legend = c("Susceptible", "Infected"),
lty = c(1, 2),
lwd = 2)
#####
