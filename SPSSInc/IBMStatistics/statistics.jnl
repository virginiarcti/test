GET DATA
 /TYPE=ODBC
 /CONNECT="DSN=Excel Files;DBQ=C:\Users\VIRGINIAH\Desktop\Dr Henry Yatich\Effectiveness of Service-Learning in Promoting "+
 "Graduate Employability in Kenya's HEIs(1-119) (1).xlsx;DriverId=1046;MaxBufferSize=2048;PageTimeout=5;"
 /SQL='SELECT `I have participated in service-learning before by supporting a c` AS '+
 'I_have_participated_in_servicelearning_before_by_supporting_a_c, `Service-Learning improves the ability to secure '+
 'employment oppor` AS ServiceLearning_improves_the_ability_to_secure_employment_oppor, `Through Service-Learning, one '+
 'gains practical skills relevant to` AS Through_ServiceLearning_one_gains_practical_skills_relevant_to, `Problem-solving '+
 'skills are greatly improved from Service-Learnin` AS Problemsolving_skills_are_greatly_improved_from_ServiceLearnin, '+
 '`Students feel more confident when entering the job market after ` AS '+
 'Students_feel_more_confident_when_entering_the_job_market_after_, `Employers value the skills acquired through '+
 'Service-Learning act` AS Employers_value_the_skills_acquired_through_ServiceLearning_act, `Service-Learning provides '+
 'students with opportunities to engage ` AS ServiceLearning_provides_students_with_opportunities_to_engage_, `My '+
 'university’s partnership with industries through Service-Lear` AS '+
 'My_universitys_partnership_with_industries_through_ServiceLear, `The projects students work on during Service-Learning '+
 'are releva` AS The_projects_students_work_on_during_ServiceLearning_are_releva, `Service-Learning allows students to '+
 'understand how industries op` AS ServiceLearning_allows_students_to_understand_how_industries_op, `Through '+
 'Service-Learning experience, students establish valuable` AS '+
 'Through_ServiceLearning_experience_students_establish_valuable FROM `Sheet1$`'
 /ASSUMEDSTRWIDTH=255.
CACHE.
EXECUTE.
DATASET NAME DataSet1 WINDOW=FRONT.
FREQUENCIES VARIABLES=I_have_participated_in_servicelearning_before_by_supporting_a_c
 /STATISTICS=STDDEV VARIANCE MEAN MEDIAN MODE
 /HISTOGRAM
 /ORDER=ANALYSIS.
FREQUENCIES VARIABLES=ServiceLearning_improves_the_ability_to_secure_employment_oppor Through_ServiceLearning_one_gains_practical_skills_relevant_to Problemsolving_skills_are_greatly_improved_from_ServiceLearnin
 Students_feel_more_confident_when_entering_the_job_market_after_ Employers_value_the_skills_acquired_through_ServiceLearning_act ServiceLearning_provides_students_with_opportunities_to_engage_ My_universitys_partnership_with_industries_through_ServiceLear
 The_projects_students_work_on_during_ServiceLearning_are_releva ServiceLearning_allows_students_to_understand_how_industries_op Through_ServiceLearning_experience_students_establish_valuable
 /STATISTICS=STDDEV VARIANCE MEAN MEDIAN MODE
 /BARCHART FREQ
 /ORDER=ANALYSIS.
